# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: required for Delete account (Project Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=

# Optional: error monitoring (sentry.io project settings -> Client Keys (DSN))
NEXT_PUBLIC_SENTRY_DSN=
